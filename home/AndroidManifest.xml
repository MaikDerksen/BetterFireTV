<?xml version="1.0" encoding="utf-8"?>
<!-- BetterFireTV-Startbildschirm: Fassung von FireFrame (MIT, github.com/dyascj/FireFrame).
     Eigener Paketname, damit FireFrame's Auto-Update sie nicht überschreibt. Kein Internet. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="tv.betterfiretv.home" android:versionCode="101" android:versionName="1.1.3-bftv1">
    <uses-sdk android:minSdkVersion="22" android:targetSdkVersion="29" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-feature android:name="android.software.leanback" android:required="false" />
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />
    <application android:label="BetterFireTV" android:icon="@drawable/icon" android:banner="@drawable/banner"
        android:allowBackup="false" android:hardwareAccelerated="true"
        android:theme="@android:style/Theme.Black.NoTitleBar.Fullscreen">
        <activity android:name="com.fireframe.home.MainActivity"
            android:exported="true"
            android:launchMode="singleTask" android:stateNotNeeded="true"
            android:clearTaskOnLaunch="true" android:excludeFromRecents="true"
            android:screenOrientation="landscape"
            android:configChanges="keyboard|keyboardHidden|navigation|orientation|screenSize|screenLayout|uiMode|locale">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <receiver android:name="com.fireframe.home.MainActivity$Boot" android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>
        <service android:name="com.fireframe.home.HomeService"
            android:exported="true"
            android:label="BetterFireTV Home-Taste"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data android:name="android.accessibilityservice" android:resource="@xml/home_service" />
        </service>
    </application>
</manifest>
